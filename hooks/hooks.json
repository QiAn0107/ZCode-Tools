{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/zcode-tools/scripts/sync.py\" --detach || python3 \"${CLAUDE_PLUGIN_ROOT}/skills/zcode-tools/scripts/sync.py\" --detach",
            "shell": true,
            "timeoutMs": 120000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/zcode-tools/scripts/tps_snapshot.py\" --quiet || python3 \"${CLAUDE_PLUGIN_ROOT}/skills/zcode-tools/scripts/tps_snapshot.py\" --quiet",
            "shell": true,
            "timeoutMs": 15000
          }
        ]
      }
    ]
  }
}
